css
/* Базові стилі */
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: 'Roboto', sans-serif;
    background-color: #f4f7f6;
    color: #333;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
}

/* Шапка та навігація */
.header {
    background-color: #0b1f3a;
    color: #fff;
    padding: 15px 0;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
}

.wrapper {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
}

.header_wrapper {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.header_list-menu {
    display: flex;
    list-style: none;
    gap: 25px;
}

.header_link {
    color: #fff;
    text-decoration: none;
    font-weight: 500;
    font-size: 16px;
    transition: color 0.3s ease;
}

.header_link:hover {
    color: #4da6ff;
}

/* Основний контент */
main {
    flex: 1;
    max-width: 1200px;
    margin: 30px auto;
    padding: 0 20px;
    width: 100%;
}

h1, h2, h3 {
    margin-bottom: 15px;
    color: #0b1f3a;
}

p {
    line-height: 1.6;
    margin-bottom: 15px;
}

/* Картки новин (news.html) */
.news-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
    margin-top: 20px;
}

.news-card {
    background: #fff;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 4px 6px rgba(0,0,0,0.05);
    display: flex;
    flex-direction: column;
}

.news-card img {
    width: 100%;
    height: 160px;
    object-fit: cover;
}

.news-content {
    padding: 15px;
}

.news-content h3 {
    font-size: 18px;
    margin-bottom: 10px;
}

/* Таблиця розкладу (education.html) */
.schedule-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 20px;
    background: #fff;
    box-shadow: 0 4px 6px rgba(0,0,0,0.05);
    border-radius: 8px;
    overflow: hidden;
}

.schedule-table th, .schedule-table td {
    padding: 12px 15px;
    text-align: left;
    border-bottom: 1px solid #ddd;
}

.schedule-table th {
    background-color: #0b1f3a;
    color: #fff;
}

.schedule-table tr:hover {
    background-color: #f1f5f9;
}

/* Форма зворотного зв'язку (contacts.html) */
.contact-form {
    background: #fff;
    padding: 25px;
    border-radius: 8px;
    max-width: 600px;
    box-shadow: 0 4px 6px rgba(0,0,0,0.05);
}

.form-group {
    margin-bottom: 15px;
}

.form-group label {
    display: block;
    margin-bottom: 5px;
    font-weight: 500;
}

.form-group input, 
.form-group textarea {
    width: 100%;
    padding: 10px;
    border: 1px solid #ccc;
    border-radius: 4px;
    font-size: 14px;
    font-family: inherit;
}

.form-group input:focus, 
.form-group textarea:focus {
    border-color: #0b1f3a;
    outline: none;
}

.submit-btn {
    background-color: #0b1f3a;
    color: #fff;
    border: none;
    padding: 10px 20px;
    border-radius: 4px;
    cursor: pointer;
    font-size: 16px;
    transition: background 0.3s;
}

.submit-btn:hover {
    background-color: #163d71;
}

/* Підвал */
footer {
    background-color: #0b1f3a;
    color: #fff;
    text-align: center;
    padding: 15px 0;
    margin-top: auto;
}